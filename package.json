{
  "name": "roadsign-studio-3d",
  "private": false,
  "version": "1.1.0",
  "description": "Procedural 3D Road Sign & Gantry Studio + Game Engine SDK (Three.js / WebGL)",
  "type": "module",
  "main": "./src/api/index.ts",
  "module": "./src/api/index.ts",
  "exports": {
    ".": "./src/api/index.ts",
    "./api": "./src/api/index.ts",
    "./lib": "./lib/roadsign.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:lib",
    "preview": "vite preview",
    "build:lib": "esbuild src/api/core.ts --bundle --format=esm --external:three --target=es2020 --outfile=lib/roadsign.js"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
